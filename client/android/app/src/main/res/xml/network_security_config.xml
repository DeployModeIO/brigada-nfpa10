<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de seguridad de red del APK de TERRENO (Capacitor) — BUILD DE PRUEBAS.

  NOTA IMPORTANTE (build de prueba de campo): el tráfico en claro (http) queda PERMITIDO
  de forma general para poder apuntar el dispositivo a CUALQUIER PC de la LAN sin conocer
  su IP de antemano y sin recompilar (domain-config solo admite hosts exactos, no rangos).
  La propia app avisa si la URL configurada es http:// hacia un host PÚBLICO (fuera de la
  red local). En la LAN de confianza el token viaja sin cifrar.

  PRODUCCIÓN: servir el PC por HTTPS (docs/DEPLOY.md §7) y volver a
  <base-config cleartextTrafficPermitted="false" /> SIN domain-config.
  Ver client/CAPACITOR.md §7.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
