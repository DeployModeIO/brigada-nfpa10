# Puerto HTTP de la API
PORT=3200

# Capa de adaptador multi-BD: sqlite | postgres | mysql
DB_DRIVER=sqlite
# sqlite: ruta del archivo. postgres: postgres://user:pass@host:5432/db. mysql: mysql://user:pass@host:3306/db
DB_URL=./data/nfpa.db

# Secreto JWT HS256 (CAMBIAR en producción)
# C1: en NODE_ENV=production el server EXIGE un AUTH_SECRET aleatorio
# distinto de este default (openssl rand -hex 32). Solo dev local usa este valor.
AUTH_SECRET=dev-secret-cambiar
TOKEN_TTL=12h

# CORS: origen(es) permitidos, separados por coma.
# El APK Capacitor de terreno llega con origen https://localhost (WebView) o
# capacitor://localhost (esquema capacitor); añádalos para que el dispositivo alcance
# el servidor (p.ej. portable :8080). Ver client/CAPACITOR.md.
#   ALLOW_ORIGIN=http://localhost:8080,https://localhost,capacitor://localhost
ALLOW_ORIGIN=http://localhost:5199

# Límite del cuerpo JSON (fotos base64)
JSON_LIMIT=10mb

# Intervalo del job de alertas por webhook (ms)
WEBHOOK_INTERVAL_MS=60000

# --- Integración a la base de datos del CLIENTE FINAL (PRODUCT-LINE.md §NORMA 3) ---
# off | referencia (leer maestros del cliente / alta masiva) | espejo (escribir inspecciones/rechazos)
INTEGRATION_MODE=off
# Driver del DB destino del cliente: postgres | mysql | sqlite (sqlserver|oracle = stubs 501)
CLIENT_DB_DRIVER=postgres
# Cadena de conexión del DB DEL CLIENTE (jamás se persiste desde el test de conexión del admin)
CLIENT_DB_URL=
# Listas maestras a leer en modo referencia (JSON: nombre -> {table,id,label,where,limit})
# p.ej. {"equipos":{"table":"equipos_contraincendio","id":"cod_equipo","label":"descripcion"}}
INTEGRATION_REF_LISTS={}
# Mapeo columna-cliente -> columna-extintor para POST /integration/ref/:lista/importar
# p.ej. {"cod_equipo":"tag","area":"ubicacion","agente":"agente","capacidad_kg":"capacidad_l"}
INTEGRATION_IMPORT_MAP={}
# Intervalo del job de la cola espejo (ms)
ESPEJO_INTERVAL_MS=30000

# --- HTTPS opcional en producción (LAN interna/empresa) ---
# Si AMBOS están definidos, el servidor arranca por HTTPS (node:https) en el mismo puerto.
# Valores: rutas a los ficheros PEM (relativas a server/) o el PEM inline.
# Genere el par autofirmado (10 años, SAN localhost + IP LAN) con:
#   cd server && ./scripts/gen-cert.sh 192.168.1.100
# Solo para LAN interna de confianza; en internet público use un certificado de CA real.
TLS_CERT=
TLS_KEY=
